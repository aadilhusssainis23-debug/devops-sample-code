
pipeline {
    agent {
        label 'python-agent'
    }

    options {
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('python-flask-app') {
                    echo 'Installing Python dependencies...'
                    sh 'python --version'
                    sh 'python -m pip install --user -r requirements.txt'
                }
            }
        }

        stage('Test') {
            steps {
                dir('python-flask-app') {
                    echo 'Running unit tests...'
                    sh 'python -m unittest discover -s . -p "test_*.py"'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('python-flask-app') {
                    echo 'Preparing deployment directory...'
                    sh '''
                        mkdir -p python-app-deploy
                        cp app.py requirements.txt test_app.py python-app-deploy/
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                dir('python-flask-app') {
                    echo 'Testing the deployed application...'
                    sh '''
                        cd python-app-deploy
                        python -m pip install --user -r requirements.txt
                        python -m unittest discover -s . -p "test_*.py"
                    '''
                }
            }
        }

        stage('Test Application') {
            steps {
                dir('python-flask-app/python-app-deploy') {
                    echo 'Verifying the application response...'
                    sh '''
                        python -c "from app import app; r=app.test_client().get('/'); assert r.status_code == 200; print(r.data.decode())"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for details.'
        }
    }
}
